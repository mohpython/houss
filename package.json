{
  "name": "saha-sante",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "db:import-supabase": "bash scripts/migrate-from-supabase.sh",
    "storage:import-supabase": "tsx --env-file-if-exists=.env scripts/migrate-storage-from-supabase.ts",
    "cap:prepare": "node -e \"require('fs').mkdirSync('dist',{recursive:true});require('fs').writeFileSync('dist/index.html','<!doctype html><meta charset=utf-8><title>SAHA Sant\u00e9</title>')\""
  },
