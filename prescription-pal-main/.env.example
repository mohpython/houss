# =============================================================================
# SAHA Santé — configuration (copier en .env et remplir)
# Les variables VITE_* sont publiques (intégrées au JavaScript du navigateur au
# moment du build) : n'y mettez jamais de secret. Relancer `npm run build`
# après les avoir modifiées.
# =============================================================================

# --- Application -------------------------------------------------------------
# (NODE_ENV=production est fixé par PM2, ne pas le mettre ici)
# URL publique, sans slash final
APP_URL=https://sahasantemali.com
# Port d'écoute du serveur Node (Nginx fait le proxy vers ce port)
PORT=3000
HOST=127.0.0.1
# Secret long et aléatoire : openssl rand -base64 48
APP_SECRET=
# Durée de vie des sessions (jours, prolongée à chaque utilisation)
SESSION_TTL_DAYS=60
# Dossier des fichiers téléversés (ordonnances). À sauvegarder !
STORAGE_DIR=/var/www/saha/storage
# Tâches planifiées (rappels de rendez-vous…) dans le processus web
SCHEDULER_ENABLED=true

# --- Base de données PostgreSQL ---------------------------------------------
DATABASE_URL=postgresql://saha:MOT_DE_PASSE@localhost:5432/saha?schema=public

# --- Intelligence artificielle (lecture d'ordonnances, triage) ---------------
# Toute API compatible OpenAI. Par défaut OpenRouter (https://openrouter.ai/keys).
# Alternative Google AI Studio :
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL_VISION=gemini-2.5-flash  /  AI_MODEL_TEXT=gemini-2.5-flash
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL_VISION=google/gemini-2.5-flash
AI_MODEL_TEXT=google/gemini-2.5-flash

# --- Connexion Google (facultatif) ------------------------------------------
# Google Cloud Console → API et services → Identifiants → ID client OAuth (Web)
# URI de redirection autorisée : ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Connexion par téléphone (code à 6 chiffres) -----------------------------
# log       = code écrit dans les logs (développement uniquement, désactivé en prod)
# twilio    = SMS via Twilio
# whatsapp  = modèle WhatsApp « Authentification » (voir WHATSAPP_OTP_TEMPLATE)
# orangesms = SMS via Orange (Mali + tous opérateurs : Orange et Moov).
#             Requiert : ORANGE_SMS_CLIENT_ID, ORANGE_SMS_CLIENT_SECRET,
#             ORANGE_SMS_SENDER. Sans ces trois variables, la connexion par
#             téléphone reste désactivée (erreur 503 explicite, pas de log).
OTP_CHANNEL=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# --- Orange SMS (Mali) ------------------------------------------------------
# Identifiants obtenus sur developer.orange.com (produit « SMS Mali »).
# ORANGE_SMS_SENDER : numéro ou alias expéditeur, ex. +22370000000.
# ORANGE_SMS_TOKEN_URL / ORANGE_SMS_SEND_URL : surcharges optionnelles si le
# produit « SMS Mali (Business) » utilise des URL différentes.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=
ORANGE_SMS_TOKEN_URL=
ORANGE_SMS_SEND_URL=
WHATSAPP_OTP_TEMPLATE=saha_otp
WHATSAPP_OTP_TEMPLATE_LANG=fr

# --- E-mails (mot de passe oublié) -------------------------------------------
# Hostinger : smtp.hostinger.com, port 465, adresse email créée dans hPanel
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SAHA Santé <no-reply@sahasantemali.com>

# --- Google Maps -------------------------------------------------------------
# Clé serveur (itinéraires, géocodage)
GOOGLE_MAPS_API_KEY=
# Clé navigateur restreinte par référent HTTP (cartes affichées) — publique
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_TRACKING_ID=

# --- CinetPay (paiement en ligne Orange Money, Moov Money, Wave, cartes) -----
# Créer un compte sur https://cinetpay.com
# Clés sandbox pour tests, puis passer en production
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=
CINETPAY_RETURN_URL=

# --- Orange Money WebPay (paiement en ligne direct aux pharmacies) -----------
# Une seule application Orange Developer pour SAHA Santé (client_id/secret
# communs). Chaque pharmacie a son PROPRE code marchand, stocké en base
# (table pharmacies.orange_merchant_key) et saisi dans Admin → Pharmacies.
# Webhook à déclarer : ${APP_URL}/api/public/payments/orange/notify
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
# Code marchand par défaut (facultatif — les pharmacies ont le leur en base)
ORANGE_MONEY_MERCHANT_KEY=
# dev = orange-money-webpay/dev/v1 (devise OUV, montants fictifs)
# Mali production = orange-money-webpay/ml/v1 (devise XOF, montants réels)
ORANGE_MONEY_API_PATH=orange-money-webpay/dev/v1
# OUV = test, XOF = FCFA réel (production Mali)
ORANGE_MONEY_CURRENCY=OUV
# URLs publiques (Orange refuse localhost). Vides = dérivées de APP_URL.
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_NOTIF_URL=

# --- WhatsApp Cloud API (bot + bouton) ---------------------------------------
# Webhook à déclarer chez Meta : ${APP_URL}/api/public/whatsapp/webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Numéro affiché sur le bouton flottant (format international sans +) — public
VITE_WHATSAPP_NUMBER=

# --- Notifications push (Firebase Cloud Messaging) ---------------------------
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
# Contenu JSON complet de la clé de compte de service, sur UNE seule ligne
FIREBASE_SERVICE_ACCOUNT_JSON=
